
<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
               Title="{Loc 'doppler-array-window-title'}"
               MinSize="660 400">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="5">
        <Label Name="NoRecords" Text="{Loc 'doppler-array-no-records'}" HorizontalExpand="True" HorizontalAlignment="Center"/>
        <ScrollContainer VerticalExpand="True">
            <ItemList Name="RecordContainer"/> <!-- Populated when window opened -->
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
